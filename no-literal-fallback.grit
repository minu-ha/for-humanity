language js

or {
    `$left ?? $right`,
    `$left || $right`
} where {
    $right <: or {
        string(),
        number(),
        `true`,
        `false`,
        `[]`,
        `{}`
    },
    register_diagnostic(span=$right, message="Do not use literals on the right side of ?? or ||. Reference a named value instead.")
}
