---
/**
 * 문서 한 장. 라우트 /[...slug] 의 진입 파일이다. 쪽을 만들기 전에 두 가지를 보고 틀리면 빌드를 멈춘다.
 * Markdown 을 그리지 못한 문서가 있는가. Astro 는 그 문서를 빈 쪽으로 두고 빌드를 이어 가므로 여기서 막는다.
 * 두 문서 이름의 첫 글자가 겹치는가. 첫 글자가 사이드바 목록의 표지다
 */

import {type CollectionEntry, getCollection, render} from "astro:content";
import type {GetStaticPaths} from "astro";
import {section_frontmatter_key} from "@/component/widget/prose/_constant/section";
import WgProse from "@/component/widget/prose/wg-prose.astro";
import WgShell from "@/component/widget/shell/wg-shell.astro";
import {copy_error_mark_clash, copy_error_prefix, copy_error_render} from "@/constant/copy";

export const getStaticPaths = (async () => {
	const docs = await getCollection("docs");
	const broken = docs.filter((doc) => doc.rendered === undefined);

	if (broken.length > 0) {
		throw new Error(`${copy_error_prefix}: ${copy_error_render}: ${broken.map((doc) => doc.filePath).join(", ")}`);
	}

	const clashes = [...Map.groupBy(docs, (doc) => doc.data.name[0].toUpperCase())].filter(
		(entry) => entry[1].length > 1,
	);

	if (clashes.length > 0) {
		throw new Error(
			`${copy_error_prefix}: ${copy_error_mark_clash}: ${clashes.map((entry) => `${entry[0]} (${entry[1].map((doc) => doc.data.name).join(", ")})`).join(" / ")}`,
		);
	}

	return docs.map((entry) => ({params: {slug: entry.id}, props: {entry}}));
}) satisfies GetStaticPaths;

interface Props {
	/**
	 * 이 쪽이 그리는 문서
	 */
	entry: CollectionEntry<"docs">;
}

const rendered = await render(Astro.props.entry);
---

<WgShell
	title={Astro.props.entry.data.name}
	current={Astro.props.entry.id}
	outline={{headings: rendered.headings, sections: rendered.remarkPluginFrontmatter[section_frontmatter_key]}}
>
	<WgProse>
		<rendered.Content />
	</WgProse>
</WgShell>
