---
/**
 * 모든 쪽의 틀. 왼쪽 칸이 사이드바, 오른쪽 칸이 본문이다. 테마는 그리기 전에 머리에서 정한다
 */

import {Font} from "astro:assets";
import {getCollection} from "astro:content";
import {siteConfig} from "virtual:for-humanity/config";
import favicon from "@/asset/favicon.svg?url";
import type {DocOutline} from "@/component/widget/shell/_type/doc-outline";
import WgShellNav from "@/component/widget/shell/_wg-shell-nav.astro";
import {font_css_variable_mono, font_css_variable_sans} from "@/constant/font";
import {theme_mode, theme_storage_key} from "@/constant/theme";
import "@/style/base.css";
import "@/style/token.css";
import "./wg-shell.css";

interface Props {
	/**
	 * 탭 제목에서 사이트 이름 앞에 붙는 문서 이름. 첫 화면은 없다
	 */
	title?: string;
	/**
	 * 지금 연 문서의 id. 첫 화면은 없다
	 */
	current?: string;
	/**
	 * 사이드바 목차의 재료. 첫 화면은 없다
	 */
	outline?: DocOutline;
}

const docs = await getCollection("docs");
---

<!doctype html>
<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{Astro.props.title ? `${Astro.props.title} · ${siteConfig.title}` : siteConfig.title}</title>
		<link rel="icon" href={favicon} type="image/svg+xml" />
		<!-- 글꼴의 @font-face. 본문 글꼴은 글자 조각이 많아 미리 받지 않고, 코드 글꼴은 파일 하나라 미리 받는다 -->
		<Font cssVariable={font_css_variable_sans} />
		<Font cssVariable={font_css_variable_mono} preload />
		<script is:inline define:vars={{themeStorageKey: theme_storage_key, storedThemes: [theme_mode.light, theme_mode.dark]}}>
			// 쪽을 여는 동안은 부드러운 스크롤을 끈다. 아래 settleHashScroll 이 자리를 맞춘 뒤 다시 켠다
			document.documentElement.style.scrollBehavior = "auto";

			try {
				const theme = localStorage.getItem(themeStorageKey);

				if (storedThemes.includes(theme)) {
					document.documentElement.setAttribute("data-theme", theme);
				}
			} catch {
				// 저장소가 막혀 있으면 시스템 테마를 따른다
			}
		</script>
	</head>
	<body class="wg_shell__root">
		<WgShellNav docs={docs} current={Astro.props.current} outline={Astro.props.outline} />
		<main class="wg_shell__main">
			<slot />
		</main>
		<script>
			import {findHashTarget} from "@/util/dom/find-hash-target";

			const hashTarget = findHashTarget(location.hash);
			const userScroll = new AbortController();

			for (const type of ["wheel", "touchmove", "keydown", "mousedown"]) {
				addEventListener(type, () => userScroll.abort(), {once: true, passive: true});
			}

			/**
			 * 주소의 #절로 들어오면 글꼴이 늦게 와 높이가 바뀐 뒤 한 번 더 맞춘다. 그새 사용자가 스크롤을 시작했으면 건너뛴다.
			 * 쪽을 여는 동안은 머리의 인라인 스크립트가 부드러운 스크롤을 꺼 둔다. 켜 두면 브라우저가 처음 옮기는 움직임이
			 * 글꼴이 오기 전 자리로 이어져, 여기서 맞춘 자리를 덮는다. 맞춘 뒤에 다시 켠다
			 */
			const settleHashScroll = async () => {
				await document.fonts.ready;

				if (hashTarget && !userScroll.signal.aborted) {
					hashTarget.scrollIntoView({behavior: "instant"});
				}

				document.documentElement.style.removeProperty("scroll-behavior");
			};

			// 글꼴 파일은 쪽의 load 무렵에야 요청이 끝나므로 load 뒤에 fonts.ready 를 기다린다
			if (document.readyState === "complete") {
				settleHashScroll();
			} else {
				addEventListener("load", settleHashScroll, {once: true});
			}
		</script>
	</body>
</html>
