{
    "name": "for-humanity",
    "version": "0.7.0",
    "description": "Documents written for humans to read: a docs kit with a sidebar, parts, sections and flowcharts, built on Hono JSX",
    "keywords": [
        "docs",
        "documentation",
        "hono",
        "markdown",
        "mermaid",
        "korean"
    ],
    "license": "MIT",
    "author": "nomeehej",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/minu-ha/for-humanity.git"
    },
    "homepage": "https://for-humanity.fyi",
    "bugs": {
        "url": "https://github.com/minu-ha/for-humanity/issues"
    },
    "type": "module",
    "bin": {
        "for-humanity": "dist/cli.js"
    },
    "files": [
        "dist",
        "src",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build:kit": "node script/build-kit.mjs",
        "sync:readme": "node util/sync-readme.mjs",
        "sync:docs": "pnpm sync:readme && node util/sync-changelog.mjs",
        "dev": "pnpm sync:docs && pnpm build:kit && node dist/cli.js dev templates/document",
        "build": "pnpm sync:docs && pnpm build:kit && node dist/cli.js build templates/document",
        "build:pages": "pnpm build && node util/prepare-pages.mjs",
        "preview": "node dist/cli.js preview templates/document",
        "test": "node script/test.mjs",
        "test:navigation": "pnpm build:kit && node util/navigation/check-navigation.test.mjs",
        "lint": "biome check && stylelint \"src/**/*.css\"",
        "lint:fix": "biome check --write && stylelint \"src/**/*.css\" --fix",
        "typecheck": "tsc --noEmit",
        "check": "pnpm lint && pnpm typecheck",
        "prepack": "pnpm build:kit"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.3",
        "@shikijs/rehype": "^4.4.3",
        "beautiful-mermaid": "^1.1.3",
        "clsx": "^2.1.1",
        "es-toolkit": "^1.52.0",
        "github-slugger": "^2.0.0",
        "hast-util-to-string": "3.0.1",
        "hono": "^4.13.12",
        "mdast-util-find-and-replace": "^3.0.2",
        "mdast-util-to-string": "^4.0.0",
        "rehype-raw": "^7.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "remark-smartypants": "^3.0.3",
        "shiki": "4.4.3",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "vfile": "^6.0.3",
        "yaml": "^2.9.1",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "@types/node": "^26.6.3",
        "esbuild": "^0.28.2",
        "mdast-util-to-hast": "^13.2.1",
        "playwright": "^1.63.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^7.0.2"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d"
}
