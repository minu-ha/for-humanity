{
    "name": "for-humanity",
    "version": "0.22.1",
    "description": "Documents written for humans to read: a docs kit with a sidebar, parts, sections and Mermaid diagrams, built on Hono JSX",
    "keywords": [
        "docs",
        "documentation",
        "hono",
        "markdown",
        "mermaid",
        "korean"
    ],
    "license": "MIT",
    "author": "nomeehej",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nomeehej/for-humanity.git"
    },
    "homepage": "https://for-humanity.fyi",
    "bugs": {
        "url": "https://github.com/nomeehej/for-humanity/issues"
    },
    "type": "module",
    "bin": {
        "for-humanity": "dist/cli.js"
    },
    "files": [
        "dist",
        "src/asset",
        "template",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "build:kit": "vite build --mode node && vite build --mode browser && vite build --mode mermaid && tsc -p tsconfig.package.json",
        "sync:readme": "tsx util/sync-readme.ts",
        "sync:docs": "pnpm sync:readme && tsx util/sync-changelog.ts",
        "dev": "pnpm sync:docs && pnpm build:kit && tsx src/entry/dev/dev.ts",
        "build": "pnpm sync:docs && pnpm build:kit && node dist/cli.js build .",
        "build:site": "pnpm build && tsx util/prepare-site.ts",
        "deploy:site": "pnpm build:site && wrangler deploy",
        "preview": "node dist/cli.js preview .",
        "test": "pnpm build:kit && vitest run",
        "test:watch": "pnpm build:kit && vitest",
        "test:browser": "pnpm build:kit && playwright test",
        "test:navigation": "pnpm build:kit && playwright test navigation",
        "test:mermaid": "pnpm build:kit && playwright test mermaid",
        "lint": "biome check && stylelint \"src/**/*.css\"",
        "lint:fix": "biome check --write && stylelint \"src/**/*.css\" --fix",
        "typecheck": "tsc --noEmit",
        "knip": "knip",
        "check": "pnpm lint && pnpm typecheck && pnpm knip",
        "prepack": "pnpm build:kit"
    },
    "dependencies": {
        "@clack/core": "^1.5.1",
        "@clack/prompts": "^1.8.1",
        "@hono/vite-dev-server": "^0.26.1",
        "@shikijs/rehype": "^4.4.3",
        "@shikijs/transformers": "4.4.3",
        "citty": "^0.2.2",
        "clsx": "^2.1.1",
        "consola": "^3.4.2",
        "es-toolkit": "^1.52.0",
        "github-slugger": "^2.0.0",
        "hast-util-to-string": "3.0.1",
        "hono": "^4.13.12",
        "image-size": "^2.0.4",
        "jiti": "^2.7.0",
        "mdast-util-find-and-replace": "^3.0.2",
        "rehype-raw": "^7.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "remark-smartypants": "^3.0.3",
        "shiki": "4.4.3",
        "string-width": "^8.3.0",
        "unhead": "^3.4.3",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "vfile": "^6.0.3",
        "vite": "^8.3.4",
        "wrap-ansi": "^10.0.2",
        "yaml": "^2.9.1",
        "zod": "^4.6.5",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@biomejs/biome": "^2.5.14",
        "@playwright/test": "1.63.0",
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "@types/node": "^26.6.3",
        "html-validate": "^11.16.4",
        "knip": "^6.42.1",
        "mdast-util-to-hast": "^13.2.1",
        "mermaid": "12.2.0",
        "publint": "^0.3.25",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vitest": "^5.0.4",
        "wrangler": "4.152.0"
    },
    "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
    "types": "./dist/type/site-config.d.ts",
    "exports": {
        ".": {
            "types": "./dist/type/site-config.d.ts",
            "import": "./dist/config.js"
        },
        "./*": "./*"
    }
}
