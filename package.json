{
	"name": "for-humanity",
	"version": "0.1.0",
	"description": "Documents written for humans to read: a docs kit with a sidebar, parts, numbered sections and flowcharts, built on Astro",
	"keywords": [
		"docs",
		"documentation",
		"astro",
		"markdown",
		"mermaid",
		"korean"
	],
	"license": "MIT",
	"author": "하민우",
	"type": "module",
	"bin": {
		"for-humanity": "./dist/cli.js"
	},
	"files": [
		"dist",
		"src"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
		"dev": "pnpm build:cli && node dist/cli.js dev templates/document",
		"build": "pnpm build:cli && node dist/cli.js build templates/document",
		"preview": "node dist/cli.js preview templates/document",
		"lint": "biome check && stylelint \"src/**/*.css\"",
		"lint:fix": "biome check --write && stylelint \"src/**/*.css\" --fix",
		"typecheck": "pnpm build:cli && node dist/cli.js sync templates/document && astro-check",
		"check": "pnpm lint && pnpm typecheck",
		"prepack": "pnpm build:cli"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.1",
		"@astrojs/mdx": "^8.0.2",
		"@astrojs/react": "^7.0.0",
		"astro": "^7.3.5",
		"beautiful-mermaid": "^1.1.3",
		"es-toolkit": "^1.52.0",
		"mdast-util-find-and-replace": "^3.0.2",
		"mdast-util-to-string": "^4.0.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"remark-directive": "^4.0.0",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.14",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.3",
		"esbuild": "^0.28.2",
		"mdast-util-to-hast": "^13.2.1",
		"stylelint": "^17.15.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^6.0.3",
		"vfile": "^6.0.3"
	}
}
