{
    "name": "for-humanity",
    "version": "0.1.0",
    "description": "Documents written for humans to read: a docs kit with a sidebar, parts, numbered sections and flowcharts, built on Hono and React",
    "keywords": [
        "docs",
        "documentation",
        "hono",
        "react",
        "markdown",
        "mermaid",
        "korean"
    ],
    "license": "MIT",
    "author": "하민우",
    "type": "module",
    "bin": {
        "for-humanity": "./dist/cli.js"
    },
    "files": [
        "dist",
        "src"
    ],
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build:kit": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --jsx=automatic --outfile=dist/cli.js && esbuild src/client.ts --bundle --platform=browser --format=esm --jsx=automatic --minify --define:process.env.NODE_ENV='\"production\"' --outdir=dist",
        "dev": "pnpm build:kit && node dist/cli.js dev templates/document",
        "build": "pnpm build:kit && node dist/cli.js build templates/document",
        "build:pages": "pnpm build && node util/prepare-pages.mjs",
        "preview": "node dist/cli.js preview templates/document",
        "test": "esbuild src/util/font/to-font-css.test.ts src/content/read-docs.test.ts --bundle --platform=node --format=esm --packages=external --outbase=src --outdir=node_modules/.cache/for-humanity-tests --out-extension:.js=.mjs && node --test node_modules/.cache/for-humanity-tests/content/*.test.mjs node_modules/.cache/for-humanity-tests/util/font/*.test.mjs",
        "lint": "biome check && stylelint \"src/**/*.css\"",
        "lint:fix": "biome check --write && stylelint \"src/**/*.css\" --fix",
        "typecheck": "tsc --noEmit",
        "check": "pnpm lint && pnpm typecheck",
        "prepack": "pnpm build:kit"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.3",
        "@shikijs/rehype": "^4.4.3",
        "beautiful-mermaid": "^1.1.3",
        "clsx": "^2.1.1",
        "es-toolkit": "^1.52.0",
        "github-slugger": "^2.0.0",
        "hast-util-to-string": "3.0.1",
        "hono": "^4.13.12",
        "mdast-util-find-and-replace": "^3.0.2",
        "mdast-util-to-string": "^4.0.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "rehype-raw": "^7.0.0",
        "rehype-stringify": "^10.0.1",
        "remark-directive": "^4.0.0",
        "remark-frontmatter": "^5.0.0",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "remark-smartypants": "^3.0.3",
        "shiki": "4.4.3",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.1.0",
        "vfile": "^6.0.3",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.14",
        "@types/hast": "^3.0.5",
        "@types/mdast": "^4.0.4",
        "@types/node": "^26.6.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "esbuild": "^0.28.2",
        "mdast-util-to-hast": "^13.2.1",
        "playwright": "^1.63.0",
        "stylelint": "^17.15.0",
        "stylelint-config-standard": "^40.0.0",
        "typescript": "^7.0.2"
    }
}
