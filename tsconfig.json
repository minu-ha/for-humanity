{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "strict": true,
        "verbatimModuleSyntax": true,
        "noEmit": true,
        "skipLibCheck": true,
        "allowJs": false,
        "types": ["node", "vite/client"],
        "paths": {
            "@/*": ["./src/*"],
            "@test/*": ["./test/*"],
            "@tool/*": ["./util/*"],
            "for-humanity": ["./src/type/site-config.ts"]
        },
        "allowImportingTsExtensions": true
    },
    "include": ["src", "test", "vitest.config.ts", "vite.config.ts", "playwright.config.ts", "util", "for-humanity.config.ts", "template/for-humanity.config.ts"],
    "exclude": ["dist", "content/dist", "template/**/dist"]
}
